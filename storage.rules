rules_version = '2';

// Cloud Storage holds profile pictures only (profile_pictures/{uid}/avatar.jpg).
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_pictures/{uid}/{fileName} {
      // Any signed-in member can see profile pictures.
      allow read: if request.auth != null;

      // Only you can change your own picture: images up to 5 MB.
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
