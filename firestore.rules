rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // CORE RBAC HELPER FUNCTIONS
    // ==========================================
    function isAuthed() { return request.auth != null; }
    
    // Safely retrieve the user's participant document
    function getParticipant(instId) {
      let uid = request.auth != null ? request.auth.uid : 'null_uid';
      let pDoc = /databases/$(database)/documents/institutes/$(instId)/participants/$(uid);
      return exists(pDoc) ? get(pDoc).data : {};
    }
    
    function isInstituteMember(instId) {
      return isAuthed() && exists(/databases/$(database)/documents/institutes/$(instId)/participants/$(request.auth.uid));
    }
    
    function isActiveMember(instId) {
      let participant = getParticipant(instId);
      return isInstituteMember(instId) && participant.get('status', 'active') == 'active';
    }
    
    function isAdmin(instId) {
      let participant = getParticipant(instId);
      return isInstituteMember(instId) && participant.get('role', '') == 'admin';
    }

    // ==========================================
    // GLOBAL COLLECTIONS
    // ==========================================
    match /institutes/{instId} {
      // Allow anyone to read the list of institutes for login/registration
      allow read: if true;
      // Creation restricted to super_admins (managed purely backend-side)
      allow write: if isAuthed() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
      
      // ==========================================
      // PARTICIPANTS (Users)
      // ==========================================
      match /participants/{userId} {
        allow read: if request.auth.uid == userId || isActiveMember(instId) || isAdmin(instId);
        
        // Users may only change their own profile fields; role, status, deletion
        // flags, email and customId are managed by admins and Cloud Functions.
        allow update: if isAdmin(instId) || (
          request.auth.uid == userId && isActiveMember(instId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'rollNo', 'year', 'interest', 'bio', 'company', 'department',
            'profileImage', 'isProfileComplete', 'searchKeywords',
            'isMentor', 'isHiring', 'openToNetworking',
            'fcmTokens', 'notificationPrefs', 'updatedAt'
          ])
        );

        allow create, delete: if isAdmin(instId);
      }
      
      // ==========================================
      // POSTS (News & Events)
      // ==========================================
      match /posts/{postId} {
        // Visibilities a non-admin may read; feed queries must filter on these
        // (`visibility in [...]`) or Firestore rejects the query.
        function visibleTo() {
          let role = getParticipant(instId).get('role', 'student');
          return role == 'alumni' ? ['public', 'alumni_only'] : ['public', 'students_only'];
        }
        function changed() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }
        function delta(field) {
          return request.resource.data.get(field, 0) - resource.data.get(field, 0);
        }
        // likeCount moves by one only together with your own like record.
        function likeStepOk() {
          let like = /databases/$(database)/documents/institutes/$(instId)/posts/$(postId)/likes/$(request.auth.uid);
          return delta('likeCount') == 0 ||
            (delta('likeCount') == 1 && !exists(like) && existsAfter(like)) ||
            (delta('likeCount') == -1 && exists(like) && !existsAfter(like));
        }
        // attendeeCount moves by one only when your own RSVP changes, within capacity.
        function attendeeStepOk() {
          let rsvp = /databases/$(database)/documents/institutes/$(instId)/posts/$(postId)/attendees/$(request.auth.uid);
          let wasGoing = exists(rsvp) && get(rsvp).data.get('status', '') == 'attending';
          let isGoing = existsAfter(rsvp) && getAfter(rsvp).data.get('status', '') == 'attending';
          let cap = request.resource.data.get('maxAttendees', null);
          return delta('attendeeCount') == 0 ||
            (delta('attendeeCount') == 1 && !wasGoing && isGoing &&
              (cap == null || request.resource.data.get('attendeeCount', 0) <= cap)) ||
            (delta('attendeeCount') == -1 && wasGoing && !isGoing);
        }
        function counterUpdateOk() {
          return changed().hasOnly(['likeCount', 'commentCount', 'attendeeCount']) &&
            likeStepOk() && attendeeStepOk() &&
            delta('commentCount') in [-1, 0, 1];
        }
        // Authors edit content; type stays student/alumni-postable and pinning stays admin-only.
        function authorEditOk() {
          return resource.data.get('authorUid', '') == request.auth.uid &&
            changed().hasOnly([
              'title', 'description', 'category', 'visibility', 'searchKeywords', 'type',
              'eventDate', 'eventLocation', 'registrationRequired', 'maxAttendees',
              'waitlistEnabled', 'status', 'updatedAt'
            ]) &&
            request.resource.data.get('type', '') in ['experience', 'event'] &&
            request.resource.data.get('status', 'published') in ['published', 'deleted'];
        }

        allow read: if isAdmin(instId) ||
          (isActiveMember(instId) && resource.data.visibility in visibleTo());

        allow create: if isActiveMember(instId) &&
          request.resource.data.get('authorUid', '') == request.auth.uid && (
            isAdmin(instId) ||
            (getParticipant(instId).get('role', '') in ['student', 'alumni'] &&
             request.resource.data.get('type', '') in ['experience', 'event'] &&
             request.resource.data.get('isPinned', false) == false &&
             request.resource.data.get('likeCount', 0) == 0 &&
             request.resource.data.get('commentCount', 0) == 0 &&
             request.resource.data.get('attendeeCount', 0) == 0)
          );

        allow update: if isAdmin(instId) || (
          isActiveMember(instId) && (authorEditOk() || counterUpdateOk())
        );

        allow delete: if isAdmin(instId) || (isActiveMember(instId) && resource.data.get('authorUid', '') == request.auth.uid);

        match /comments/{commentId} {
          allow read: if isActiveMember(instId) || isAdmin(instId);
          allow create: if isActiveMember(instId) && request.resource.data.get('uid', '') == request.auth.uid;
          allow update: if isAdmin(instId) || (
            isActiveMember(instId) && resource.data.get('uid', '') == request.auth.uid &&
            request.resource.data.get('uid', '') == resource.data.get('uid', '')
          );
          allow delete: if isAdmin(instId) || (
            isActiveMember(instId) && resource.data.get('uid', '') == request.auth.uid
          );
        }

        match /likes/{userId} {
          allow read: if isActiveMember(instId) || isAdmin(instId);
          allow write: if isActiveMember(instId) && request.auth.uid == userId;
        }

        match /attendees/{userId} {
          allow read: if isActiveMember(instId) || isAdmin(instId);
          // Becoming or leaving "attending" must move attendeeCount in the same write,
          // so nobody can take a seat without it counting toward capacity.
          allow create, update: if isActiveMember(instId) && request.auth.uid == userId &&
            request.resource.data.get('status', '') in ['attending', 'waitlisted', 'declined'] &&
            (
              (resource == null || resource.data.get('status', '') != 'attending') ==
                (request.resource.data.status != 'attending') ||
              (request.resource.data.status == 'attending' &&
                getAfter(/databases/$(database)/documents/institutes/$(instId)/posts/$(postId)).data.get('attendeeCount', 0) ==
                  get(/databases/$(database)/documents/institutes/$(instId)/posts/$(postId)).data.get('attendeeCount', 0) + 1) ||
              (request.resource.data.status != 'attending' &&
                getAfter(/databases/$(database)/documents/institutes/$(instId)/posts/$(postId)).data.get('attendeeCount', 0) ==
                  get(/databases/$(database)/documents/institutes/$(instId)/posts/$(postId)).data.get('attendeeCount', 0) - 1)
            );
          allow delete: if false;
        }
      }
      
      // ==========================================
      // MESSAGING
      // ==========================================
      match /chats/{chatId} {
        allow read: if isActiveMember(instId) && request.auth.uid in resource.data.get('participants', []);
        
        // Prevent array injection for chat creation
        allow create: if isActiveMember(instId) && 
                      request.resource.data.get('participants', []).size() == 2 &&
                      request.auth.uid in request.resource.data.get('participants', []);
                      
        // Prevent modifying participants during an update.
        // Compared as sets: clients write [sender, receiver], so the order flips when the other user replies.
        allow update: if isActiveMember(instId) &&
                      request.auth.uid in resource.data.get('participants', []) &&
                      request.resource.data.get('participants', []).size() == 2 &&
                      request.resource.data.get('participants', []).toSet() == resource.data.get('participants', []).toSet();
        
        match /messages/{messageId} {
          function chatPath() {
            return /databases/$(database)/documents/institutes/$(instId)/chats/$(chatId);
          }
          // getAfter: the first message is written in the same batch that creates the chat.
          function isChatParticipantAfter() {
            return request.auth.uid in getAfter(chatPath()).data.get('participants', []);
          }
          function changedKeys() {
            return request.resource.data.diff(resource.data).affectedKeys();
          }

          allow read: if isActiveMember(instId) &&
            request.auth.uid in get(chatPath()).data.get('participants', []);

          // You can only send messages as yourself.
          allow create: if isActiveMember(instId) && isChatParticipantAfter() &&
            request.resource.data.get('senderId', '') == request.auth.uid;

          allow update: if isActiveMember(instId) && isChatParticipantAfter() && (
            // Only the sender may edit the text.
            (resource.data.get('senderId', '') == request.auth.uid &&
             changedKeys().hasOnly(['text', 'isEdited'])) ||
            // Anyone in the chat may react.
            changedKeys().hasOnly(['reactions']) ||
            // "Delete for me" may only touch your own flag.
            (changedKeys().hasOnly(['deletedBy']) &&
             request.resource.data.deletedBy.diff(resource.data.get('deletedBy', {})).affectedKeys().hasOnly([request.auth.uid]))
          );

          // Messages are never hard-deleted from the client.
          allow delete: if false;
        }
      }
      
      // ==========================================
      // ADMIN & QUEUES
      // ==========================================
      match /admin_actions/{docId} { 
        allow read: if isAdmin(instId);
        // Prevent spoofing audit logs
        allow create: if isAdmin(instId) && request.resource.data.get('adminUid', '') == request.auth.uid;
        allow update, delete: if false; // Audit logs should be immutable
      }
      
      match /deletion_queue/{docId} { 
        allow read, write: if isAdmin(instId); 
      }
      
      // ==========================================
      // USER REQUESTS
      // ==========================================
      match /reactivation_requests/{reqId} {
        allow create: if request.auth.uid == reqId && request.resource.data.status == 'pending';
        allow read: if request.auth.uid == reqId || isAdmin(instId);
        allow update: if isAdmin(instId) || (request.auth.uid == reqId && request.resource.data.status == 'pending');
        allow delete: if isAdmin(instId);
      }
      
      match /feedback/{feedbackId} {
        allow create: if isActiveMember(instId);
        allow read, update, delete: if isAdmin(instId);
      }
    }
  }
}
